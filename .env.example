# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，绝不提交
POSTGRES_PASSWORD=change_me
NEO4J_PASSWORD=change_me
NEO4J_QUERY_TIMEOUT_SECONDS=2
NEO4J_FAILURE_THRESHOLD=3
NEO4J_OPEN_SECONDS=30

# LLM（DeepSeek，OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embedding / Rerank（SiliconFlow，OpenAI 兼容接口，见 V3 方案 4.1 与 ADR）
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 简历原文与PII映射的加密密钥 (随机32+字符)
RESUME_ENC_KEY=change_me_random_32_chars

# Mem0 Platform（可选；启用后用于跨会话长期记忆，服务端调用）
MEM0_ENABLED=false
MEM0_BASE_URL=https://api.mem0.ai
MEM0_API_KEY=
MEM0_TIMEOUT_SECONDS=2
MEM0_FAILURE_THRESHOLD=3
MEM0_OPEN_SECONDS=30

# JWT HS256 密钥（随机 32+ 字符）；生产环境必填
JWT_SECRET=change_me_random_32_chars_or_more

# 阿里云 OSS 私有知识库原文件存储（AccessKey 仅由后端读取）
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=knowledge-documents/

# 本地演示入口；生产 profile 无论此值为何都会关闭
DEV_LOGIN_ENABLED=true
AUTH_COOKIE_SECURE=false

# LLM 单实例并发上限
LLM_MAX_IN_FLIGHT=16

# 仅本地评估所用的 /internal/* 端点；生产 profile 会强制关闭
INTERNAL_ENDPOINTS_ENABLED=true
