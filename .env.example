# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，绝不提交
POSTGRES_PASSWORD=change_me
NEO4J_PASSWORD=change_me
NEO4J_QUERY_TIMEOUT_SECONDS=2
NEO4J_FAILURE_THRESHOLD=3
NEO4J_OPEN_SECONDS=30

# LLM（DeepSeek，OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 路由安全阈值：只有高置信度越界请求才跳过知识检索
ROUTING_OUT_OF_SCOPE_THRESHOLD=0.92
# 路由置信度校准器默认关闭；启用前先提供经过标注集验证的模型文件
ROUTING_CALIBRATION_ENABLED=false
ROUTING_CALIBRATION_MODEL_PATH=classpath:routing/isotonic-oos-v1.json

# Embedding / Rerank（SiliconFlow，OpenAI 兼容接口，见 V3 方案 4.1 与 ADR）
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 简历原文与PII映射的加密密钥 (随机32+字符)
# Encrypts resume originals, PII mappings, and conversation originals/summaries.
RESUME_ENC_KEY=change_me_random_32_chars
RESUME_ENC_KEY_ID=v1
# 轮换期间临时保留；旧 Episode 重加密完成后删除。
RESUME_ENC_PREVIOUS_KEY=
RESUME_ENC_PREVIOUS_KEY_ID=

# Mem0 Platform（可选；启用后用于跨会话长期记忆，服务端调用）
MEM0_ENABLED=false
MEM0_BASE_URL=https://api.mem0.ai
MEM0_API_KEY=
MEM0_TIMEOUT_SECONDS=2
MEM0_FAILURE_THRESHOLD=3
MEM0_OPEN_SECONDS=30
MEMORY_SYNC_LEASE_SECONDS=300
MEMORY_SYNC_RETRY_LIMIT_PER_MINUTE=3
MEMORY_SYNC_METRICS_REFRESH_MS=10000

# JWT HS256 密钥（随机 32+ 字符）；生产环境必填
JWT_SECRET=change_me_random_32_chars_or_more

# 阿里云 OSS 私有知识库原文件存储（AccessKey 仅由后端读取）
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=knowledge-documents/

# 文档上传与摄取吞吐（默认单文件 50 MB；扩大前请同步检查反向代理、Tomcat 和内存）
KNOWLEDGE_UPLOAD_MAX_FILE_SIZE=50MB
KNOWLEDGE_UPLOAD_MAX_REQUEST_SIZE=55MB
KNOWLEDGE_MULTIPART_THRESHOLD=8MB
KNOWLEDGE_MULTIPART_PART_SIZE=8MB
KNOWLEDGE_UPLOAD_SESSION_TTL=24h
KNOWLEDGE_UPLOAD_MAX_PER_HOUR=20
KNOWLEDGE_INGESTION_MAX_IN_FLIGHT=4
KNOWLEDGE_EMBEDDING_CONCURRENCY=8
KNOWLEDGE_INGESTION_MAX_PENDING_JOBS=1000

# 本地演示入口；生产 profile 无论此值为何都会关闭
DEV_LOGIN_ENABLED=true
AUTH_COOKIE_SECURE=false

# LLM 单实例并发上限
LLM_MAX_IN_FLIGHT=16

# 预算分层：每用户每日 token 限额；后台任务 (摘要/抽取/批量嵌入) 在全局日限额中的占比 %
LLM_USER_DAILY_TOKEN_LIMIT=300000
LLM_BACKGROUND_SHARE_PERCENT=20

# 仅本地评估所用的 /internal/* 端点；生产 profile 会强制关闭
INTERNAL_ENDPOINTS_ENABLED=true
